# APGI Framework - Security Configuration
# Copy this file to .env and update with your actual values
# NEVER commit the actual .env file to version control

# ============================================================================
# HTTPS & Security
# ============================================================================

# Force HTTPS in production
VITE_FORCE_HTTPS=true

# Enable Content Security Policy
VITE_ENABLE_CSP=true

# Enable CORS protection
VITE_ENABLE_CORS_PROTECTION=true

# Enable rate limiting
VITE_ENABLE_RATE_LIMITING=true

# ============================================================================
# Authentication & Session
# ============================================================================

# Use HttpOnly cookies for auth tokens (requires backend support)
VITE_USE_HTTPONLY_COOKIES=true

# Session timeout in milliseconds (1 hour)
VITE_SESSION_TIMEOUT=3600000

# Token refresh interval in milliseconds (15 minutes before expiry)
VITE_TOKEN_REFRESH_INTERVAL=900000

# ============================================================================
# reCAPTCHA Configuration
# ============================================================================

# Get these from https://www.google.com/recaptcha/admin

# reCAPTCHA v3 Site Key (public - safe to expose)
# Do NOT use the secret key in frontend - backend only!
VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

# reCAPTCHA minimum score (0.0 = bot, 1.0 = human)
# Recommended: 0.5 (allow some uncertainty)
VITE_RECAPTCHA_MIN_SCORE=0.5

# ============================================================================
# API Configuration
# ============================================================================

# Backend API base URL
VITE_API_BASE_URL=https://api.apgiframework.com

# API request timeout (milliseconds)
VITE_API_TIMEOUT=10000

# ============================================================================
# Third-Party Services (Public Keys Only)
# ============================================================================

# Stripe Publishable Key (public - safe to expose)
# Get from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51...

# Stripe Product/Price IDs
VITE_STRIPE_PROFESSIONAL_PRICE_ID=price_1...
VITE_STRIPE_ENTERPRISE_PRICE_ID=price_2...

# ============================================================================
# Email Services (Public Keys Only)
# ============================================================================

# Mailchimp API Key (use public key or restricted API key)
VITE_MAILCHIMP_API_KEY=your_mailchimp_api_key
VITE_MAILCHIMP_SERVER_PREFIX=us1
VITE_MAILCHIMP_SNAPSHOT_LIST_ID=list_id_1
VITE_MAILCHIMP_NEWSLETTER_LIST_ID=list_id_2
VITE_MAILCHIMP_CONSULTATIONS_LIST_ID=list_id_3

# ConvertKit API Key (audience key - safe for frontend)
VITE_CONVERTKIT_API_KEY=your_convertkit_api_key
VITE_CONVERTKIT_SNAPSHOT_FORM_ID=form_id_1
VITE_CONVERTKIT_PROFESSIONAL_FORM_ID=form_id_2

# ============================================================================
# Analytics (Optional)
# ============================================================================

# Google Analytics Tracking ID
VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Plausible Analytics Domain
VITE_PLAUSIBLE_DOMAIN=apgiframework.com

# ============================================================================
# Development & Debugging
# ============================================================================

# Enable debug mode (logs security events)
VITE_DEBUG_MODE=false

# Enable development security warnings
VITE_DEVELOPMENT_WARNINGS=true

# ============================================================================
# BACKEND CONFIGURATION (NOT FRONTEND)
# ============================================================================

# These should NEVER be exposed to the frontend!
# Keep these secret and only in backend .env

# NOTE: These are examples of what should be on the backend only:
# - RECAPTCHA_SECRET_KEY (for verifying tokens)
# - DATABASE_PASSWORD (for backend database)
# - JWT_SECRET (for signing tokens)
# - STRIPE_SECRET_KEY (for backend payments)
# - MAILCHIMP_SECRET_KEY (if using restricted key)
# - SESSION_SECRET (for session management)

# ============================================================================
# SECURITY NOTES
# ============================================================================

# IMPORTANT SECURITY RULES:
#
# 1. NEVER commit .env to version control
#    Add to .gitignore: .env, .env.local, .env.*.local
#
# 2. NEVER put secret keys in frontend
#    Frontend can only have public/restricted keys
#    Example: Stripe Publishable Key is OK, Secret Key is NOT
#
# 3. ALWAYS use HTTPS in production
#    Ensure VITE_FORCE_HTTPS=true
#
# 4. ALWAYS verify reCAPTCHA tokens on backend
#    Frontend obtains token, backend verifies
#
# 5. Use environment variables, not hardcoded values
#    This file is an example - use actual .env for real values
#
# 6. Rotate secrets regularly
#    Especially if a developer leaves
#
# 7. Use separate keys for dev/staging/production
#    Never use production keys in development
#
# 8. Backend must set HttpOnly cookies
#    Frontend cannot set HttpOnly (by design)
#
# 9. All sensitive data should be handled on backend
#    Encryption, hashing, secure storage
#
# 10. Keep dependencies updated
#     Run: npm audit fix (regularly)

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================

# 1. Rename this file:
#    mv .env.security.example .env.local
#
# 2. Update all values with your actual credentials:
#    - Get reCAPTCHA keys from Google Cloud Console
#    - Get Stripe keys from Stripe Dashboard
#    - Get email service keys from respective providers
#
# 3. Ensure .env.local is in .gitignore:
#    echo ".env.local" >> .gitignore
#
# 4. Restart development server:
#    npm run dev
#
# 5. Test that values are loaded:
#    console.log(window.envConfig.get("recaptcha.siteKey"))
#
# 6. Verify security:
#    window.securityManager.getSecurityReport()

# ============================================================================
# DEVELOPMENT VS PRODUCTION
# ============================================================================

# Development (.env.development):
#   - reCAPTCHA: Use test keys
#   - Stripe: Use test keys (pk_test_*)
#   - HTTPS: Can be disabled for localhost
#   - Debug: Can be true for logging

# Production (.env.production):
#   - reCAPTCHA: Use real keys
#   - Stripe: Use real keys (pk_live_*)
#   - HTTPS: MUST be true
#   - Debug: MUST be false
#   - All URLs: Use HTTPS

# ============================================================================
